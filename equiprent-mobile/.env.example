# Copia este archivo como .env.local (no se sube a Git) y ajusta la URL.
# Android Emulator -> 10.0.2.2 es el localhost de tu PC.
# Teléfono físico con Expo Go -> usa la IP de tu PC en el Wi-Fi, ej. http://192.168.0.15:8080/api
# Después de cambiarlo: npx expo start -c
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
